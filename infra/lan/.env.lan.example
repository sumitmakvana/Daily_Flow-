# DailyFlow LAN stack settings. start.ps1 creates .env.lan from this file on first run,
# filling secrets from infra/.env.local-test and the JWKS from infra/docker-compose.local.yml.
# .env.lan is git-ignored. Never commit real secrets.

# --- Network ---
# Leave empty to auto-detect the Windows Wi-Fi/Ethernet IPv4; set it (e.g. 192.168.1.20) to override.
LAN_IP=
# APP_PORT must contain "7050" and AUTH_PORT the same digits with "7052" (browser derives the
# Keycloak URL by replacing 7050 -> 7052). Defaults avoid the local stack's 7050-7052.
APP_PORT=17050
API_PORT=17051
AUTH_PORT=17052

# --- Seed dump (restored once into the new pgdata_lan volume; supplies Keycloak keys + data) ---
DUMP_FILE=../dump-postgres-202610271113operon.dump

# --- Postgres (internal only, never published) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- App / API keys (must match the JWKS in PGRST_JWT_SECRET) ---
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PGRST_JWT_SECRET=

# --- Keycloak admin (console at http://<LAN_IP>:<AUTH_PORT>/admin) ---
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

CRON_SECRET=

# --- Optional: email / push (leave empty to disable) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FCM_SERVICE_ACCOUNT_JSON=
